# Required for `console` mode (local mic/speaker test, no LiveKit account needed):
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# LLM provider for the router + ack generator: at least ONE of these two is
# required, not both. Anthropic (Claude Haiku) is the designed default when
# present; Gemini is the fully-supported fallback for when it isn't --
# see gemini_client.py. If both are set, Anthropic wins unless LLM_PROVIDER
# says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# LLM_PROVIDER=gemini

# Defaults to mock-agent-backend's own default port -- override once real
# CollectiveOS exists.
COLLECTIVEOS_WS_URL=ws://localhost:8000/v1/ws

# Only needed for `dev`/`start` (a real LiveKit room). WorkerOptions reads
# these itself -- not read by our own config.py.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Unset means no error tracking, not a startup failure -- read
# directly in main(), not through Settings(), so --help keeps working with
# no env vars set at all.
SENTRY_DSN=
